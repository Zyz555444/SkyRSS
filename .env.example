# Clerk（https://dashboard.clerk.com）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook 签名密钥（Clerk Dashboard → Webhooks → Signing Secret）
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon Postgres（建议使用 pooled connection string）
DATABASE_URL=
# 首次连接前必须在 Neon 上建表：在本目录执行 npm run db:migrate（会读取 .env.local / .env 中的 DATABASE_URL），
# 或在 Neon → SQL Editor 粘贴并执行 drizzle/0000_init.sql 全文。
