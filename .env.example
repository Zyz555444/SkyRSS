# Clerk（https://dashboard.clerk.com）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook 签名密钥（Clerk Dashboard → Webhooks → Signing Secret）
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon Postgres（建议使用 pooled connection string）
DATABASE_URL=
# 本地：首次建表可执行 npm run db:migrate（会读取 .env.local / .env），或在 Neon SQL Editor 执行 drizzle/0000_init.sql。
# Vercel：`npm run build` 会先运行迁移；请在 Project → Environment Variables 添加 DATABASE_URL，
# 并对 Production / Preview 勾选「在构建时可用」(Expose to Build)，否则构建会失败。
